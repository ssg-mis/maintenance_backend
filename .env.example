PORT=5000
NODE_ENV=development

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/maintenance_management
# Or set these separately instead of DATABASE_URL:
DB_HOST=localhost
DB_PORT=5432
DB_NAME=maintenance_management
DB_USER=postgres
DB_PASSWORD=postgres

JWT_SECRET=change_this_to_a_long_random_secret
CORS_ORIGIN=http://localhost:5173
DOWNTIME_COST_PER_HOUR=500
